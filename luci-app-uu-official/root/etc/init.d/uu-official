#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

NAME="uu-official"
MANAGER="/usr/libexec/uu-official/manager.sh"
MONITOR="/usr/sbin/uu/uuplugin_monitor.sh"

start_service() {
	config_load uu-official
	local enabled model
	config_get_bool enabled main enabled 0
	config_get model main model auto

	[ "$enabled" -eq 1 ] || {
		logger -t "$NAME" "service is disabled in UCI"
		return 0
	}

	"$MANAGER" prepare "$model" || return 1

	procd_open_instance
	procd_set_param command /bin/sh "$MONITOR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}

stop_service() {
	"$MANAGER" stop-runtime
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger uu-official
}

